{
  "name": "Instagram 자동 포스팅",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * 1,3,5"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 300],
      "notes": "월/수/금 오후 6시에 실행"
    },
    {
      "parameters": {
        "url": "={{$env.CONTENT_API_URL}}/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "platform",
              "value": "instagram"
            },
            {
              "name": "template_type",
              "value": "carousel"
            },
            {
              "name": "variables",
              "value": "={{ JSON.stringify($json.variables) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "generate-content",
      "name": "콘텐츠 생성 API 호출",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "url": "https://graph.facebook.com/v18.0/{{$env.INSTAGRAM_BUSINESS_ACCOUNT_ID}}/media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $json.image_url }}"
            },
            {
              "name": "caption",
              "value": "={{ $json.content.main_text }}"
            },
            {
              "name": "access_token",
              "value": "={{$env.INSTAGRAM_ACCESS_TOKEN}}"
            }
          ]
        },
        "options": {}
      },
      "id": "instagram-create-media",
      "name": "Instagram 미디어 생성",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "notes": "Meta Graph API를 통해 미디어 컨테이너 생성"
    },
    {
      "parameters": {
        "url": "https://graph.facebook.com/v18.0/{{$env.INSTAGRAM_BUSINESS_ACCOUNT_ID}}/media_publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "access_token",
              "value": "={{$env.INSTAGRAM_ACCESS_TOKEN}}"
            }
          ]
        },
        "options": {}
      },
      "id": "instagram-publish",
      "name": "Instagram 발행",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "notes": "미디어 컨테이너를 실제로 발행"
    },
    {
      "parameters": {
        "channel": "#social-media",
        "text": "📸 Instagram 포스트가 자동으로 게시되었습니다!\n\n📝 캡션: {{ $node['콘텐츠 생성 API 호출'].json.content.main_text.substring(0, 100) }}...\n\n🔗 Instagram에서 확인하세요.",
        "otherOptions": {}
      },
      "id": "slack-notify",
      "name": "Slack 알림",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [900, 300],
      "credentials": {
        "slackApi": {
          "id": "YOUR_SLACK_CREDENTIAL_ID",
          "name": "Slack"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "콘텐츠 생성 API 호출",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "콘텐츠 생성 API 호출": {
      "main": [
        [
          {
            "node": "Instagram 미디어 생성",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Instagram 미디어 생성": {
      "main": [
        [
          {
            "node": "Instagram 발행",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Instagram 발행": {
      "main": [
        [
          {
            "node": "Slack 알림",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "description": "Instagram에 AI 생성 콘텐츠를 자동으로 포스팅하는 워크플로우 (Meta Graph API 사용)",
    "author": "BaryonLabs",
    "version": "1.0.0",
    "requirements": [
      "Instagram Business Account",
      "Facebook Page 연결",
      "Meta Graph API Access Token"
    ]
  },
  "tags": [
    "social-media",
    "instagram",
    "automation"
  ]
}

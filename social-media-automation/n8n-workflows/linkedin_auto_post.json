{
  "name": "LinkedIn 자동 포스팅",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 2,3,4"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 300],
      "notes": "화/수/목 오전 9시에 실행"
    },
    {
      "parameters": {
        "url": "={{$env.CONTENT_API_URL}}/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "platform",
              "value": "linkedin"
            },
            {
              "name": "template_type",
              "value": "thought_leadership"
            },
            {
              "name": "variables",
              "value": "={{ JSON.stringify($json.variables) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "generate-content",
      "name": "콘텐츠 생성 API 호출",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "resource": "post",
        "postType": "text",
        "text": "={{ $json.content.main_text }}\n\n{{ $json.content.hashtags.map(h => '#' + h).join(' ') }}",
        "visibility": "PUBLIC"
      },
      "id": "linkedin-post",
      "name": "LinkedIn 포스트 작성",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "YOUR_LINKEDIN_CREDENTIAL_ID",
          "name": "LinkedIn OAuth2"
        }
      }
    },
    {
      "parameters": {
        "channel": "#social-media",
        "text": "✅ LinkedIn 포스트가 자동으로 게시되었습니다!\n\n📝 내용: {{ $json.content.main_text.substring(0, 100) }}...\n\n🔗 LinkedIn에서 확인하세요.",
        "otherOptions": {}
      },
      "id": "slack-notify",
      "name": "Slack 알림",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [700, 300],
      "credentials": {
        "slackApi": {
          "id": "YOUR_SLACK_CREDENTIAL_ID",
          "name": "Slack"
        }
      }
    },
    {
      "parameters": {
        "errorMessage": "LinkedIn 포스팅 실패: {{ $json.error }}"
      },
      "id": "error-handler",
      "name": "에러 처리",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [500, 500]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "콘텐츠 생성 API 호출",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "콘텐츠 생성 API 호출": {
      "main": [
        [
          {
            "node": "LinkedIn 포스트 작성",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "LinkedIn 포스트 작성": {
      "main": [
        [
          {
            "node": "Slack 알림",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "description": "LinkedIn에 AI 생성 콘텐츠를 자동으로 포스팅하는 워크플로우",
    "author": "BaryonLabs",
    "version": "1.0.0"
  },
  "tags": [
    "social-media",
    "linkedin",
    "automation"
  ]
}
